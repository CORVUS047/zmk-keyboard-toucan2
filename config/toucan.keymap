#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ALT  3

/ {
    macros {
        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RCTRL>, <&macro_tap &kp C>, <&macro_release &kp RCTRL>;
        };
        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RCTRL>, <&macro_tap &kp V>, <&macro_release &kp RCTRL>;
        };
        shift_ctrl_c: shift_ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RSHIFT>, <&macro_press &kp RCTRL>, <&macro_tap &kp C>, <&macro_release &kp RCTRL>, <&macro_release &kp RSHIFT>;
        };
        shift_ctrl_v: shift_ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RSHIFT>, <&macro_press &kp RCTRL>, <&macro_tap &kp V>, <&macro_release &kp RCTRL>, <&macro_release &kp RSHIFT>;
        };
        t_t: t_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp T>, <&macro_tap &kp T>;
        };
        z_z: z_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Z>, <&macro_tap &kp Z>;
        };
        d_d: d_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp D>, <&macro_tap &kp D>;
        };
        c_c: c_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp C>, <&macro_tap &kp C>;
        };
        x_x: x_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp X>, <&macro_tap &kp X>;
        };
        h_h: h_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp H>, <&macro_tap &kp H>;
        };
        comma_comma: comma_comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp COMMA>, <&macro_tap &kp COMMA>;
        };
        dot_dot: dot_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp DOT>, <&macro_tap &kp DOT>;
        };
        fslh_fslh: fslh_fslh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp FSLH>, <&macro_tap &kp FSLH>;
        };
        a_a: a_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp A>, <&macro_tap &kp A>;
        };
        q_q: q_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Q>, <&macro_tap &kp Q>;
        };
        o_o: o_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp O>, <&macro_tap &kp O>;
        };
        semi_semi: semi_semi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp SEMI>, <&macro_tap &kp SEMI>;
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp D>, <&d_d>, <&to 3>;
        };
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&c_c>, <&to 5>;
        };
        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp X>, <&x_x>, <&bt BT_NXT>;
        };
        td3: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Z>, <&z_z>, <&bt BT_PRV>;
        };
        td4: tap_dance_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp H>, <&h_h>, <&to 6>;
        };
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp COMMA>, <&comma_comma>, <&to 7>;
        };
        td6: tap_dance_6 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DOT>, <&dot_dot>, <&bt BT_CLR>;
        };
        td7: tap_dance_7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp FSLH>, <&fslh_fslh>;
        };
        td8: tap_dance_8 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp F>, <&kp T>, <&t_t>;
        };
        td9: tap_dance_9 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp X>, <&kp Z>, <&z_z>;
        };
        td10: tap_dance_10 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&a_a>, <&ctrl_c>;
        };
        td11: tap_dance_11 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&q_q>, <&shift_ctrl_c>;
        };
        td12: tap_dance_12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&o_o>, <&ctrl_v>;
        };
        td13: tap_dance_13 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&semi_semi>, <&shift_ctrl_v>;
        };
        hm0: hold_mod_0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td0>;
        };
        hm1: hold_mod_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td1>;
        };
        hm2: hold_mod_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td2>;
        };
        hm3: hold_mod_3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td3>;
        };
        hm4: hold_mod_4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td4>;
        };
        hm5: hold_mod_5 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td5>;
        };
        hm6: hold_mod_6 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td6>;
        };
        hm7: hold_mod_7 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&td7>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &trans   &td11 &kp W &kp F &kp P &kp B      &kp J &kp L  &kp U  &kp Y  &td13  &trans
                &trans   &td10 &kp R &kp S &kp T &kp G      &kp M &kp N  &kp E  &kp I  &td12  &trans
                &trans   &hm3 LGUI 0  &hm2 LCTRL 0  &hm1 LALT 0  &hm0 LSHIFT 0  &kp V      &kp K  &hm4 RSHIFT 0  &hm5 RALT 0  &hm6 RCTRL 0  &hm7 RGUI 0  &trans
                                &kp TAB &kp SPACE &mo 1   &mo 2 &kp RET &kp BSPC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans     &kp PSCRN  &kp SLCK     &kp UP       &trans       &kp PG_UP   &kp PLUS   &kp N7    &kp N8  &kp N9    &kp C_FF      &trans
                &trans     &kp INSERT &kp LEFT     &kp DOWN     &kp RIGHT    &kp PG_DN   &kp MINUS  &kp N4    &kp N5  &kp N6    &kp C_RW      &trans
                &trans     &kp CAPS   &kp ESC      &kp DEL      &kp HOME     &kp END     &kp N0     &kp N1    &kp N2  &kp N3    &kp C_SHUFFLE &trans
                                      &kp TAB     &kp SPACE       &trans      &trans  &kp RET   &kp BSPC
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans   &kp C_NEXT &kp C_VOL_UP &kp LBKT &kp RBKT &kp EXCL   &kp TILDE &kp DLLR  &kp UNDER  &kp CARET &kp LT    &trans
                &trans   &kp C_PP   &kp C_MUTE   &kp LBRC &kp RBRC &kp PIPE   &kp STAR  &kp AT    &kp HASH   &kp BSLH  &kp EQUAL &trans
                &trans   &kp C_PREV &kp C_VOL_DN &kp LPAR &kp RPAR &kp AMPS   &kp PRCNT &kp SQT   &kp DQT    &kp GRAVE &kp GT    &trans
                                             &kp TAB &kp SPACE  &trans               &trans   &kp RET    &kp BSPC
            >;
        };

        game {
            display-name = "GAME";
            bindings = <
                &trans  &td8       &kp Q &kp W &kp E &kp R     &kp Y  &kp U  &kp I      &kp O   &kp P     &trans
                &trans  &kp LSHIFT &kp A &kp S &kp D &kp G     &kp H  &kp J  &kp K      &kp L   &kp SEMI  &trans
                &trans  &kp LCTRL  &td9  &kp C &kp V &kp B     &kp N  &kp M  &kp COMMA  &kp DOT &kp FSLH  &trans
                                &kp TAB &kp SPACE &mo 4   &mo 2 &kp RET &kp BSPC
            >;
        };

        gnum {
            display-name = "GNUM";
            bindings = <
                &trans &kp PG_UP &kp N7 &kp N8 &kp N9 &kp PLUS           &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &kp PG_DN &kp N4 &kp N5 &kp N6 &kp EQUAL          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &kp N0    &kp N1 &kp N2 &kp N3 &kp MINUS          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_2 {
            display-name = "RES1";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_3 {
            display-name = "RES2";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_4 {
            display-name = "RES3";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        alt {
            display-name = "ALT";
            bindings = <
                &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10         &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &kp F11 &kp F12 &kp F13 &kp F14 &sys_reset      &sys_reset &to 0 &to 0 &to 0 &to 0 &trans
                            &bootloader &to 0 &trans    &trans &trans &bootloader
            >;
        };
    };
};

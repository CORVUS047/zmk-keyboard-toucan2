#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ALT  3

/ {
    macros {
        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RCTRL>, <&macro_tap &kp C>, <&macro_release &kp RCTRL>;
        };
        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RCTRL>, <&macro_tap &kp V>, <&macro_release &kp RCTRL>;
        };
        shift_ctrl_c: shift_ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RSHIFT>, <&macro_press &kp RCTRL>, <&macro_tap &kp C>, <&macro_release &kp RCTRL>, <&macro_release &kp RSHIFT>;
        };
        shift_ctrl_v: shift_ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RSHIFT>, <&macro_press &kp RCTRL>, <&macro_tap &kp V>, <&macro_release &kp RCTRL>, <&macro_release &kp RSHIFT>;
        };
        t_t: t_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp T>, <&macro_tap &kp T>;
        };
        z_z: z_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Z>, <&macro_tap &kp Z>;
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt LSHIFT D>, <&to 3>;
        };
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt LALT C>, <&to 5>;
        };
        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt LCTRL X>, <&bt BT_NXT>;
        };
        td3: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt LGUI Z>, <&bt BT_PRV>;
        };
        td4: tap_dance_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt RSHIFT H>, <&to 6>;
        };
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt RALT COMMA>, <&to 7>;
        };
        td6: tap_dance_6 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt RCTRL DOT>, <&bt BT_CLR>;
        };
        td7: tap_dance_7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&mt RGUI FSLH>, <&studio_unlock>;
        };
        td8: tap_dance_8 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp F>, <&kp T>, <&t_t>;
        };
        td9: tap_dance_9 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp X>, <&kp Z>, <&z_z>;
        };
        td10: tap_dance_10 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp A>, <&ctrl_c>;
        };
        td11: tap_dance_11 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp Q>, <&shift_ctrl_c>;
        };
        td12: tap_dance_12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp O>, <&ctrl_v>;
        };
        td13: tap_dance_13 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&kp SEMI>, <&shift_ctrl_v>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &trans   &td11 &kp W &kp F &kp P &kp B      &kp J &kp L  &kp U  &kp Y  &td13  &trans
                &trans   &td10 &kp R &kp S &kp T &kp G      &kp M &kp N  &kp E  &kp I  &td12  &trans
                &trans   &td3  &td2  &td1  &td0  &kp V      &kp K &td4   &td5   &td6   &td7   &trans
                                &kp TAB &kp SPACE &mo 1   &mo 2 &kp RET &kp BSPC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans     &kp F1    &kp F2       &kp UP       &trans       &kp PG_UP   &kp PLUS   &kp N7     &kp N8  &kp N9    &kp F5 &trans
                &trans     &kp F3    &kp LEFT     &kp DOWN     &kp RIGHT    &kp PG_DN   &kp MINUS  &kp N4    &kp N5  &kp N6    &kp F6 &trans
                &trans     &kp F4    &kp ESC      &kp DEL      &kp HOME     &kp END     &kp N0     &kp N1    &kp N2  &kp N3    &kp F7 &trans
                                      &kp TAB     &kp SPACE       &trans      &trans  &kp RET   &kp BSPC
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans   &kp C_NEXT &kp C_VOL_UP &kp LBKT &kp RBKT &kp EXCL   &kp TILDE &kp DLLR  &kp UNDER  &kp CARET &kp LT    &trans
                &trans   &kp C_PP   &kp C_MUTE   &kp LBRC &kp RBRC &kp PIPE   &kp STAR  &kp AT    &kp HASH   &kp BSLH  &kp EQUAL &trans
                &trans   &kp C_PREV &kp C_VOL_DN &kp LPAR &kp RPAR &kp AMPS   &kp PRCNT &kp SQT   &kp DQT    &kp GRAVE &kp GT    &trans
                                             &kp TAB &kp SPACE  &trans               &trans   &kp RET    &kp BSPC
            >;
        };

        game {
            display-name = "GAME";
            bindings = <
                &trans  &td8       &kp Q &kp W &kp E &kp R     &kp Y  &kp U  &kp I      &kp O   &kp P     &trans
                &trans  &kp LSHIFT &kp A &kp S &kp D &kp G     &kp H  &kp J  &kp K      &kp L   &kp SEMI  &trans
                &trans  &kp LCTRL  &td9  &kp C &kp V &kp B     &kp N  &kp M  &kp COMMA  &kp DOT &kp FSLH  &trans
                                &kp TAB &kp SPACE &mo 4   &mo 2 &kp RET &kp BSPC
            >;
        };

        gnum {
            display-name = "GNUM";
            bindings = <
                &trans &kp PG_UP &kp N7 &kp N8 &kp N9 &kp PLUS           &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &kp PG_DN &kp N4 &kp N5 &kp N6 &kp EQUAL          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &kp N0    &kp N1 &kp N2 &kp N3 &kp MINUS          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_2 {
            display-name = "RES1";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_3 {
            display-name = "RES2";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_4 {
            display-name = "RES3";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };
    };
};

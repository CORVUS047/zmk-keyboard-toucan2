#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ALT  3

/ {
    macros {
        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RCTRL>, <&macro_tap &kp C>, <&macro_release &kp RCTRL>;
        };
        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RCTRL>, <&macro_tap &kp V>, <&macro_release &kp RCTRL>;
        };
        shift_ctrl_c: shift_ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RSHIFT>, <&macro_press &kp RCTRL>, <&macro_tap &kp C>, <&macro_release &kp RCTRL>, <&macro_release &kp RSHIFT>;
        };
        shift_ctrl_v: shift_ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RSHIFT>, <&macro_press &kp RCTRL>, <&macro_tap &kp V>, <&macro_release &kp RCTRL>, <&macro_release &kp RSHIFT>;
        };
        t_t: t_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp T>, <&macro_tap &kp T>;
        };
        z_z: z_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Z>, <&macro_tap &kp Z>;
        };
        a_a: a_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp A>, <&macro_tap &kp A>;
        };
        q_q: q_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Q>, <&macro_tap &kp Q>;
        };
        o_o: o_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp O>, <&macro_tap &kp O>;
        };
        semi_semi: semi_semi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp SEMI>, <&macro_tap &kp SEMI>;
        };
    };

    behaviors {
        td8: tap_dance_8 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp F>, <&kp T>, <&t_t>;
        };
        td9: tap_dance_9 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp X>, <&kp Z>, <&z_z>;
        };
        td10: tap_dance_10 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&a_a>, <&ctrl_c>;
        };
        td11: tap_dance_11 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&q_q>, <&shift_ctrl_c>;
        };
        td12: tap_dance_12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&o_o>, <&ctrl_v>;
        };
        td13: tap_dance_13 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&semi_semi>, <&shift_ctrl_v>;
        };
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // BASE-only system chords: left outer thumb (TAB) + the key that used
        // to carry the action on its triple-tap. require-prior-idle-ms keeps
        // them from firing mid-typing.
        combo_bt_prv {
            bindings = <&bt BT_PRV>;
            key-positions = <36 25>;   // TAB + Z
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
        combo_bt_nxt {
            bindings = <&bt BT_NXT>;
            key-positions = <36 26>;   // TAB + X
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
        combo_game {
            bindings = <&to 3>;
            key-positions = <36 28>;   // TAB + D
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
        combo_res2 {
            bindings = <&to 6>;
            key-positions = <36 31>;   // TAB + H
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
        combo_res3 {
            bindings = <&to 7>;
            key-positions = <36 32>;   // TAB + ,
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
        // Destructive: unpairs every profile. Three keys on purpose.
        combo_bt_clr {
            bindings = <&bt BT_CLR>;
            key-positions = <36 33 34>;   // TAB + . + /
            layers = <BASE>;
            timeout-ms = <75>;
            require-prior-idle-ms = <150>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &trans   &kp Q         &kp W          &kp F         &kp P           &kp B      &kp J  &kp L           &kp U         &kp Y          &kp SEMI      &trans
                &trans   &hrm LGUI A   &hrm LCTRL R   &hrm LALT S   &hrm LSHIFT T   &kp G      &kp M  &hrm RSHIFT N   &hrm RALT E   &hrm RCTRL I   &hrm RGUI O   &trans
                &trans   &kp Z         &kp X          &kp C         &kp D           &kp V      &kp K  &kp H           &kp COMMA     &kp DOT        &kp FSLH      &trans
                                &kp TAB &kp SPACE &mo 1   &mo 2 &kp RET &kp BSPC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans     &kp PSCRN  &kp SLCK     &kp UP       &trans       &kp PG_UP   &kp PLUS   &kp N7    &kp N8  &kp N9    &kp C_FF      &trans
                &trans     &kp INSERT &kp LEFT     &kp DOWN     &kp RIGHT    &kp PG_DN   &kp MINUS  &kp N4    &kp N5  &kp N6    &kp C_RW      &trans
                &trans     &kp CAPS   &kp ESC      &kp DEL      &kp HOME     &kp END     &kp N0     &kp N1    &kp N2  &kp N3    &kp C_SHUFFLE &trans
                                      &kp TAB     &kp SPACE       &trans      &trans  &kp RET   &kp BSPC
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans   &kp C_NEXT &kp C_VOL_UP &kp LBKT &kp RBKT &kp EXCL   &kp TILDE &kp DLLR  &kp UNDER  &kp CARET &kp LT    &trans
                &trans   &kp C_PP   &kp C_MUTE   &kp LBRC &kp RBRC &kp PIPE   &kp STAR  &kp AT    &kp HASH   &kp BSLH  &kp EQUAL &trans
                &trans   &kp C_PREV &kp C_VOL_DN &kp LPAR &kp RPAR &kp AMPS   &kp PRCNT &kp SQT   &kp DQT    &kp GRAVE &kp GT    &trans
                                             &kp TAB &kp SPACE  &trans               &trans   &kp RET    &kp BSPC
            >;
        };

        game {
            display-name = "GAME";
            bindings = <
                &trans  &td8       &kp Q &kp W &kp E &kp R     &kp Y  &kp U  &kp I      &kp O   &kp P     &trans
                &trans  &kp LSHIFT &kp A &kp S &kp D &kp G     &kp H  &kp J  &kp K      &kp L   &kp SEMI  &trans
                &trans  &kp LCTRL  &td9  &kp C &kp V &kp B     &kp N  &kp M  &kp COMMA  &kp DOT &kp FSLH  &trans
                                &kp TAB &kp SPACE &mo 4   &mo 2 &kp RET &kp BSPC
            >;
        };

        gnum {
            display-name = "GNUM";
            bindings = <
                &trans &kp PG_UP &kp N7 &kp N8 &kp N9 &kp PLUS           &kp KP_PLUS  &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_DOT      &trans
                &trans &kp PG_DN &kp N4 &kp N5 &kp N6 &kp EQUAL          &kp KP_MINUS &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MULTIPLY &trans
                &trans &kp N0    &kp N1 &kp N2 &kp N3 &kp MINUS          &kp KP_N0    &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_EQUAL    &trans
                            &trans &trans &trans           &to 0 &trans &trans
            >;
        };

        // Held for as long as a finger rests on the trackpad, by the
        // is_touching_processor node in boards/shields/toucan/toucan.dtsi.
        // Everything but the outer and middle thumbs is &trans: typing is
        // unaffected, the inner thumbs still reach NAV/SYM so the listener's
        // scroll override keeps working, and the thumbs that are left become
        // mouse buttons, which is what makes click-and-drag work.
        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans &trans
                            &mkp RCLK &mkp LCLK &trans           &trans &mkp LCLK &mkp MCLK
            >;
        };

        extra_3 {
            display-name = "RES2";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        extra_4 {
            display-name = "RES3";
            bindings = <
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                &trans &to 0 &to 0 &to 0 &to 0 &to 0          &to 0 &to 0 &to 0 &to 0 &to 0 &trans
                            &trans &trans &trans           &trans &trans &trans
            >;
        };

        alt {
            display-name = "ALT";
            bindings = <
                &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp KP_PLUS  &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_DOT      &trans
                &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10         &kp KP_MINUS &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MULTIPLY &trans
                &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15         &kp KP_N0    &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_EQUAL    &trans
                            &bootloader &sys_reset &trans           &trans &sys_reset &bootloader
            >;
        };
    };
};
